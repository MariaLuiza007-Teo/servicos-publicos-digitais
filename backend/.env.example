# Copie este arquivo para "backend/.env" e ajuste os valores.
# O arquivo .env NÃO vai para o Git (ele pode ter chaves secretas).

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
# Porta usada por "npm start" (produção). Em "npm run dev" a API usa sempre 3001,
# que é para onde o Vite encaminha as chamadas /api.
PORT=3001
# Endereço(s) do site que podem chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:5173
# Use 1 quando a API estiver atrás de um proxy (Render, Railway etc.)
TRUST_PROXY=0

# ---------------------------------------------------------------
# Modelo de linguagem (LLM)
# ---------------------------------------------------------------
# Opções:
#   mock   -> resposta de demonstração, sem IA (bom para mexer só no visual)
#   ollama -> Llama rodando no seu computador (https://ollama.com)
#   groq   -> Llama 3.3 70B hospedado na Groq (precisa de chave gratuita)
#   custom -> qualquer API compatível com OpenAI (preencha LLM_BASE_URL)
LLM_PROVIDER=ollama

# Opcional: sobrescreve o modelo/endereço padrão do provedor escolhido.
# Padrões: ollama = llama3.1:8b | groq = llama-3.3-70b-versatile
LLM_MODEL=
LLM_BASE_URL=
# Só para groq/custom. Nunca coloque essa chave no frontend.
LLM_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=120000

# ---------------------------------------------------------------
# RAG (base de conhecimento do assistente)
# ---------------------------------------------------------------
# Como buscar os trechos relevantes:
#   none   -> busca por palavras-chave (BM25). Não precisa de modelo extra.
#   ollama -> busca por significado com embeddings (rode: ollama pull bge-m3)
#   custom -> qualquer API de embeddings compatível com OpenAI
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=

RAG_TOP_K=4
# Similaridade mínima (0 a 1) para um trecho entrar no contexto (só embeddings)
RAG_MIN_SCORE=0.35

# ---------------------------------------------------------------
# Limites de uso
# ---------------------------------------------------------------
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_MESSAGES=8
RATE_LIMIT_PER_MINUTE=20
